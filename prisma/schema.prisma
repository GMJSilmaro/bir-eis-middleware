generator client {
  provider = "prisma-client"
  output   = "../src/lib/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Singleton platform branding (auth shell product mark). Row id is always "default".
model PlatformSettings {
  id             String   @id @default("default")
  productName    String   @map("product_name")
  productTagline String   @map("product_tagline")
  logo           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  tagline   String?
  logo      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users                   User[]
  roles                   Role[]
  eisCredential           EisCredential?
  erpConnections          ErpConnection[]
  auditLogs               AuditLog[]
  invoiceDocuments        InvoiceDocument[]
  taxpayerProfile         TaxpayerProfile?
  casRegistrations        CasRegistration[]
  complianceDocuments     ComplianceDocument[]
  complianceValidationRuns ComplianceValidationRun[]
  reconciliationChecks    ReconciliationCheck[]
  certificationProfile    CertificationProfile?
  complianceActivation    ComplianceActivation?

  @@map("tenants")
}

model User {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  email         String
  name          String    @default("")
  /// App-managed hash; Better Auth credential accounts mirror this in Account.password.
  passwordHash  String    @map("password_hash")
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles            UserRole[]
  accounts             Account[]
  sessions             Session[]
  auditLogs            AuditLog[]
  invoiceDocuments       InvoiceDocument[] @relation("DocumentCreator")
  cancellationRequests   InvoiceDocument[] @relation("CancellationRequester")
  casReviews             CasRegistration[] @relation("CasReviewer")
  complianceDocuments    ComplianceDocument[] @relation("ComplianceDocUploader")
  certificationRecorded  CertificationProfile[] @relation("CertificationRecorder")
  activationOverrides    ComplianceActivation[] @relation("ActivationOverrideActor")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

/// Tenant-scoped outbound sales docs and inbound buyer docs (inbox MVP).
model InvoiceDocument {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  /// outbound | inbound (inbound direction is legacy; Inbound UI lists outbound submissions)
  direction           String
  /// sales_invoice | official_receipt | service_billing | debit_note | credit_note
  documentType        String    @map("document_type")
  /// outbound: draft | queued | submitted | accepted | rejected
  status              String
  documentNumber      String    @map("document_number")
  issueDate           DateTime  @map("issue_date") @db.Date
  currency            String    @default("PHP")
  counterpartName     String    @map("counterpart_name")
  counterpartTin      String?   @map("counterpart_tin")
  lineExtensionAmount Decimal   @map("line_extension_amount") @db.Decimal(18, 2)
  taxAmount           Decimal   @map("tax_amount") @db.Decimal(18, 2)
  totalAmount         Decimal   @map("total_amount") @db.Decimal(18, 2)
  /// MVP line items as JSON array (header amounts are authoritative).
  lineItems           Json?     @map("line_items")
  /// CAS-shaped unsigned BIR EIS draft JSON (mapped at create/edit; not JWS-signed).
  eisJsonPayload      Json?     @map("eis_json_payload")
  /// When eisJsonPayload was last built from document + seller fields.
  eisJsonMappedAt     DateTime? @map("eis_json_mapped_at")
  eisReferenceId      String?   @map("eis_reference_id")
  /// pending | accepted | rejected (EIS response)
  eisAckStatus        String?   @map("eis_ack_status")
  eisAckMessage       String?   @map("eis_ack_message") @db.Text
  eisAckAt            DateTime? @map("eis_ack_at")
  submittedAt         DateTime? @map("submitted_at")
  notes               String?   @db.Text
  /// manual | import | erp_sync
  source              String    @default("manual")
  /// ERP provider code when source = erp_sync (sap_b1, acumatica, …)
  sourceSystem        String?   @map("source_system")
  /// ERP connection display name when source = erp_sync
  sourceLabel         String?   @map("source_label")
  /// Stable source ERP document id (for idempotency / reconciliation)
  sourceErpId         String?   @map("source_erp_id")
  /// ok | failed | quarantined (compliance validation)
  validationStatus    String?   @map("validation_status")
  /// BUSINESS | TECHNICAL (last failure class when applicable)
  failureClass        String?   @map("failure_class")
  /// Seller branch snapshot at map time (from taxpayer profile)
  sellerBranchCode    String?   @map("seller_branch_code")
  /// null | requested | pending | accepted | rejected (separate from EIS transmission status)
  cancellationStatus         String?   @map("cancellation_status")
  cancellationReason         String?   @map("cancellation_reason")
  cancellationRemarks        String?   @map("cancellation_remarks") @db.Text
  cancellationRequestedAt    DateTime? @map("cancellation_requested_at")
  cancellationRequestedById  String?   @map("cancellation_requested_by_id")
  cancelledAt                DateTime? @map("cancelled_at")
  cancellationReferenceId    String?   @map("cancellation_reference_id")
  /// pending | accepted | rejected (sandbox EIS cancellation response)
  cancellationAckStatus      String?   @map("cancellation_ack_status")
  cancellationAckMessage     String?   @map("cancellation_ack_message") @db.Text
  cancellationAckAt          DateTime? @map("cancellation_ack_at")
  /// Optional link to an original invoice (future CN/DN/adjustment workflow).
  originalDocumentId         String?   @map("original_document_id")
  createdById         String?   @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  tenant                  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy               User?            @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  cancellationRequestedBy User?            @relation("CancellationRequester", fields: [cancellationRequestedById], references: [id], onDelete: SetNull)
  originalDocument        InvoiceDocument? @relation("DocumentAdjustments", fields: [originalDocumentId], references: [id], onDelete: SetNull)
  adjustments             InvoiceDocument[] @relation("DocumentAdjustments")
  payloadVersions         DocumentPayloadVersion[]
  transmissionAttempts    TransmissionAttempt[]

  @@index([tenantId, direction, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, status, eisAckStatus])
  @@index([tenantId, direction, documentNumber])
  @@index([tenantId, cancellationStatus])
  @@index([tenantId, sourceErpId])
  @@index([tenantId, validationStatus])
  @@map("invoice_documents")
}

/// Tenant ERP connector credentials (many per tenant). Secret encrypted; UI shows last4 only.
model ErpConnection {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  /// sap_b1 | acumatica | erpnext | other
  provider         String
  name             String
  /// Vendor / product display name (e.g. SAP Business One)
  vendor           String?
  /// Software version (e.g. 10.x)
  version          String?
  /// cas | cba | pos | invoicing_software | custom_erp | other
  systemType       String?   @map("system_type")
  /// rest_api | database | file_import | webhook | other
  integrationMethod String?  @map("integration_method")
  /// head_office | branch | multi
  scope            String?
  /// test | prod (source system environment)
  environment      String?   @default("test")
  baseUrl          String?   @map("base_url")
  username         String?
  secretCiphertext String?   @map("secret_ciphertext") @db.Text
  secretLast4      String?   @map("secret_last4")
  /// Legacy JSON map ERP source keys → portal fields (migrated to FieldMapping rows).
  fieldMap         Json?     @map("field_map")
  /// Whether connection test/sync has succeeded (readiness gate).
  connectionVerified Boolean @default(false) @map("connection_verified")
  enabled          Boolean   @default(true)
  lastSyncAt       DateTime? @map("last_sync_at")
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fieldMappings FieldMapping[]

  @@index([tenantId])
  @@map("erp_connections")
}

/// Tenant EIS / PTT credential vault (1:1). API key stored encrypted; UI shows last4 only.
model EisCredential {
  id               String    @id @default(cuid())
  tenantId         String    @unique @map("tenant_id")
  tin              String
  /// cert = EIS certification/sandbox; prod = production EIS
  environment      String    @default("cert")
  pttNumber        String?   @map("ptt_number")
  /// not_started | pending | active | expired
  pttStatus        String    @default("not_started") @map("ptt_status")
  apiKeyCiphertext String?   @map("api_key_ciphertext") @db.Text
  apiKeyLast4      String?   @map("api_key_last4")
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("eis_credentials")
}

/// Slim ISMS-style audit trail (tenant-scoped). Append-only — no update/delete APIs.
model AuditLog {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  userId        String?  @map("user_id")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  metadata      Json?
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  reason        String?  @db.Text
  correlationId String?  @map("correlation_id")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([tenantId, correlationId])
  @@map("audit_logs")
}

/// Taxpayer compliance profile (documentary / readiness — not BIR-verified).
model TaxpayerProfile {
  id               String    @id @default(cuid())
  tenantId         String    @unique @map("tenant_id")
  registeredName   String?   @map("registered_name")
  tin              String?
  branchCode       String?   @map("branch_code")
  /// head_office | branch
  officeType       String?   @map("office_type")
  rdoCode          String?   @map("rdo_code")
  /// large_taxpayer | regular | other
  classification   String?
  /// vat | non_vat
  vatMode          String?   @map("vat_mode")
  businessAddress  String?   @map("business_address") @db.Text
  contactName      String?   @map("contact_name")
  contactEmail     String?   @map("contact_email")
  contactPhone     String?   @map("contact_phone")
  /// NOT_PROVIDED | PENDING_REVIEW | DOCUMENTATION_PROVIDED | REVIEWED
  profileStatus    String    @default("NOT_PROVIDED") @map("profile_status")
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("taxpayer_profiles")
}

/// CAS registration documentary evidence (not BIR-verified by this app).
model CasRegistration {
  id                   String    @id @default(cuid())
  tenantId             String    @map("tenant_id")
  ackCertificateRef    String?   @map("ack_certificate_ref")
  issuedAt             DateTime? @map("issued_at") @db.Date
  registeredSystem     String?   @map("registered_system")
  systemVersion        String?   @map("system_version")
  rdoOffice            String?   @map("rdo_office")
  /// head_office | branch | both
  applicability        String?
  /// MISSING | PROVIDED | UNDER_REVIEW | REVIEWED | REJECTED
  status               String    @default("MISSING")
  reviewerId           String?   @map("reviewer_id")
  reviewedAt           DateTime? @map("reviewed_at")
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("CasReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("cas_registrations")
}

/// Supporting documents stored in DB (ephemeral filesystem unsafe on deploy).
model ComplianceDocument {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  /// cas_registration | taxpayer_profile | certification | other
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  /// Base64-encoded content (MVP; keep files small)
  contentBase64 String @map("content_base64") @db.Text
  byteSize    Int      @map("byte_size")
  uploadedById String? @map("uploaded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation("ComplianceDocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@map("compliance_documents")
}

/// Explicit ERP → canonical → EIS field mapping (per connection).
model FieldMapping {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  connectionId    String   @map("connection_id")
  erpField        String   @map("erp_field")
  canonicalField  String   @map("canonical_field")
  eisField        String?  @map("eis_field")
  required        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  connection ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, erpField])
  @@unique([connectionId, canonicalField])
  @@index([tenantId])
  @@index([connectionId])
  @@map("field_mappings")
}

/// One compliance validation execution (onboarding / invoice / batch / pre_transmit / readiness).
model ComplianceValidationRun {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  /// onboarding | invoice | batch | pre_transmit | readiness
  scope       String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  ruleVersion String   @map("rule_version")
  overallOutcome String @map("overall_outcome")
  blockingFailureCount Int @default(0) @map("blocking_failure_count")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  results ComplianceValidationResult[]

  @@index([tenantId, createdAt])
  @@index([tenantId, scope])
  @@map("compliance_validation_runs")
}

model ComplianceValidationResult {
  id                   String  @id @default(cuid())
  runId                String  @map("run_id")
  ruleCode             String  @map("rule_code")
  category             String
  /// PASS | FAIL | WARNING | NOT_APPLICABLE
  outcome              String
  message              String  @db.Text
  expected             String? @db.Text
  actual               String? @db.Text
  severity             String
  blocking             Boolean @default(false)
  source               String?
  regulatoryReference  String? @map("regulatory_reference")

  run ComplianceValidationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([ruleCode])
  @@map("compliance_validation_results")
}

/// Immutable payload snapshots for an invoice lifecycle.
model DocumentPayloadVersion {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  invoiceDocumentId  String   @map("invoice_document_id")
  /// ORIGINAL_ERP | CANONICAL | EIS_DRAFT | EIS_SIGNED | BIR_RESPONSE | VALIDATION_RESULT
  kind               String
  payload            Json
  createdAt          DateTime @default(now()) @map("created_at")

  invoiceDocument InvoiceDocument @relation(fields: [invoiceDocumentId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceDocumentId, createdAt])
  @@index([invoiceDocumentId, kind])
  @@map("document_payload_versions")
}

/// Per-attempt EIS transmission ledger (idempotent retries).
model TransmissionAttempt {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  invoiceDocumentId String    @map("invoice_document_id")
  attemptNo         Int       @map("attempt_no")
  idempotencyKey    String    @map("idempotency_key")
  /// BUSINESS | TECHNICAL | null
  failureClass      String?   @map("failure_class")
  httpStatus        Int?      @map("http_status")
  /// queued | transmitting | acknowledged | accepted | rejected | retry_pending | technical_failure
  status            String
  requestMeta       Json?     @map("request_meta")
  responseMeta      Json?     @map("response_meta")
  nextRetryAt       DateTime? @map("next_retry_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  invoiceDocument InvoiceDocument @relation(fields: [invoiceDocumentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey, attemptNo])
  @@index([tenantId, invoiceDocumentId])
  @@index([tenantId, status])
  @@map("transmission_attempts")
}

model ReconciliationCheck {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  findingCount     Int      @default(0) @map("finding_count")
  createdById      String?  @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  findings ReconciliationFinding[]

  @@index([tenantId, createdAt])
  @@map("reconciliation_checks")
}

model ReconciliationFinding {
  id          String  @id @default(cuid())
  checkId     String  @map("check_id")
  /// MISSING_IN_MW | NEVER_TRANSMITTED | NO_ACK | UNRESOLVED_REJECT | DUPLICATE_SOURCE | AMOUNT_MISMATCH | STATUS_MISMATCH | STALE_PENDING
  code        String
  severity    String
  message     String  @db.Text
  entityType  String? @map("entity_type")
  entityId    String? @map("entity_id")
  metadata    Json?

  check ReconciliationCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId])
  @@index([code])
  @@map("reconciliation_findings")
}

/// Recorded EIS certification / PTT evidence — not BIR-verified by this app.
model CertificationProfile {
  id            String    @id @default(cuid())
  tenantId      String    @unique @map("tenant_id")
  pttNumber     String?   @map("ptt_number")
  /// NOT_RECORDED | RECORDED | UNDER_REVIEW | REVIEWED
  status        String    @default("NOT_RECORDED")
  certPortalNote String?  @map("cert_portal_note") @db.Text
  notes         String?   @db.Text
  recordedById  String?   @map("recorded_by_id")
  recordedAt    DateTime? @map("recorded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordedBy User?  @relation("CertificationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@map("certification_profiles")
}

/// Server-enforced production activation gate state machine.
model ComplianceActivation {
  id                   String    @id @default(cuid())
  tenantId             String    @unique @map("tenant_id")
  /// DRAFT | TAXPAYER_PROFILE_COMPLETE | … | PRODUCTION_ENABLED
  gateState            String    @default("DRAFT") @map("gate_state")
  productionEnabled    Boolean   @default(false) @map("production_enabled")
  productionEnabledAt  DateTime? @map("production_enabled_at")
  testTransmissionPassed Boolean @default(false) @map("test_transmission_passed")
  reconciliationPassed Boolean   @default(false) @map("reconciliation_passed")
  lastOverrideReason   String?   @map("last_override_reason") @db.Text
  lastOverrideAt       DateTime? @map("last_override_at")
  lastOverrideById     String?   @map("last_override_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastOverrideBy User?  @relation("ActivationOverrideActor", fields: [lastOverrideById], references: [id], onDelete: SetNull)

  @@map("compliance_activations")
}

model Role {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  slug        String
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

// Better Auth adapter tables
model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
