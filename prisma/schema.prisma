generator client {
  provider = "prisma-client"
  output   = "../src/lib/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  tagline   String?
  logo      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users             User[]
  roles             Role[]
  eisCredential     EisCredential?
  erpConnections    ErpConnection[]
  auditLogs         AuditLog[]
  invoiceDocuments  InvoiceDocument[]

  @@map("tenants")
}

model User {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  email         String
  name          String    @default("")
  /// App-managed hash; Better Auth credential accounts mirror this in Account.password.
  passwordHash  String    @map("password_hash")
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles        UserRole[]
  accounts         Account[]
  sessions         Session[]
  auditLogs        AuditLog[]
  invoiceDocuments InvoiceDocument[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

/// Tenant-scoped outbound sales docs and inbound buyer docs (inbox MVP).
model InvoiceDocument {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  /// outbound | inbound (inbound direction is legacy; Inbound UI lists outbound submissions)
  direction           String
  /// sales_invoice | official_receipt | service_billing | debit_note | credit_note
  documentType        String    @map("document_type")
  /// outbound: draft | queued | submitted | accepted | rejected
  status              String
  documentNumber      String    @map("document_number")
  issueDate           DateTime  @map("issue_date") @db.Date
  currency            String    @default("PHP")
  counterpartName     String    @map("counterpart_name")
  counterpartTin      String?   @map("counterpart_tin")
  lineExtensionAmount Decimal   @map("line_extension_amount") @db.Decimal(18, 2)
  taxAmount           Decimal   @map("tax_amount") @db.Decimal(18, 2)
  totalAmount         Decimal   @map("total_amount") @db.Decimal(18, 2)
  /// MVP line items as JSON array (header amounts are authoritative).
  lineItems           Json?     @map("line_items")
  eisReferenceId      String?   @map("eis_reference_id")
  /// pending | accepted | rejected (EIS response)
  eisAckStatus        String?   @map("eis_ack_status")
  eisAckMessage       String?   @map("eis_ack_message") @db.Text
  eisAckAt            DateTime? @map("eis_ack_at")
  submittedAt         DateTime? @map("submitted_at")
  notes               String?   @db.Text
  createdById         String?   @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, direction, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, direction, documentNumber])
  @@map("invoice_documents")
}

/// Tenant ERP connector credentials (many per tenant). Secret encrypted; UI shows last4 only.
model ErpConnection {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  /// sap_b1 | acumatica | erpnext | other
  provider         String
  name             String
  baseUrl          String?   @map("base_url")
  username         String?
  secretCiphertext String?   @map("secret_ciphertext") @db.Text
  secretLast4      String?   @map("secret_last4")
  /// Maps ERP source keys → BIR/portal outbound field names.
  fieldMap         Json?     @map("field_map")
  enabled          Boolean   @default(true)
  lastSyncAt       DateTime? @map("last_sync_at")
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("erp_connections")
}

/// Tenant EIS / PTT credential vault (1:1). API key stored encrypted; UI shows last4 only.
model EisCredential {
  id               String    @id @default(cuid())
  tenantId         String    @unique @map("tenant_id")
  tin              String
  /// cert = EIS certification/sandbox; prod = production EIS
  environment      String    @default("cert")
  pttNumber        String?   @map("ptt_number")
  /// not_started | pending | active | expired
  pttStatus        String    @default("not_started") @map("ptt_status")
  apiKeyCiphertext String?   @map("api_key_ciphertext") @db.Text
  apiKeyLast4      String?   @map("api_key_last4")
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("eis_credentials")
}

/// Slim ISMS-style audit trail (tenant-scoped).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Role {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  slug        String
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

// Better Auth adapter tables
model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
